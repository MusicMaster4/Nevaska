{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nevaska",
  "version": "0.1.0",
  "identifier": "dev.slop.nevaska",
  "build": {
    "beforeDevCommand": "node scripts/fetch-stockfish.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-stockfish.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nevaska",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#151515"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "resources": [
      "resources/stockfish/*"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQzgwOUMwNkVDMDkzMjUKUldRbGs4QnV3QW5JTW5Rb3RUbVhPVFFoTEVWTCtWeS83QTh4enJFamdKUm5RUjJaSDNlMlNHOXAK",
      "endpoints": [
        "https://github.com/MusicMaster4/Nevaska/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
